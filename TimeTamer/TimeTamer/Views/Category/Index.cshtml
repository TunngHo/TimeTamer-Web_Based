@model Dictionary<string, int>
@{
    ViewData["Title"] = "Category Statistics";
}

<style>
    .hover-card { transition: all 0.3s ease; }
    .hover-card:hover { transform: translateY(-8px); box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important; border-color: #0d6efd !important; }
</style>

<div class="container mt-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary"><i class="bi bi-pie-chart-fill me-2"></i>Statistics by Category</h2>
        <p class="text-muted">Click a card to view tasks in that category.</p>
    </div>
    <div class="row g-4 justify-content-center">
        @foreach (var type in new[] { "Work", "Study", "Hangout", "Sport", "Daily" })
        {
            int count = Model.ContainsKey(type) ? Model[type] : 0;
            <div class="col-md-4 col-sm-6">
                <a asp-controller="Task" asp-action="Index" asp-route-type="@type" class="text-decoration-none">
                    <div class="card border-0 shadow-sm text-center p-4 rounded-4 bg-light hover-card border">
                        <h4 class="fw-bold text-dark text-uppercase">@type</h4>
                        <h1 class="display-1 fw-bold text-primary my-2">@count</h1>
                        <p class="text-muted mb-0 small">active tasks</p>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

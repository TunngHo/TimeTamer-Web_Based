@model TimeTamer.Models.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="container profile-shell py-4">
    <div class="password-layout">
        <div class="security-panel">
            <span class="profile-kicker">Security</span>
            <h1>Change Password</h1>
            <p>Use a fresh password that is hard to guess and different from passwords you use elsewhere.</p>
            <div class="security-point"><i class="bi bi-check2-circle"></i><span>Use at least 8 characters.</span></div>
            <div class="security-point"><i class="bi bi-check2-circle"></i><span>Mix letters, numbers, and symbols.</span></div>
            <div class="security-point"><i class="bi bi-check2-circle"></i><span>Avoid names, birthdays, or reused passwords.</span></div>
        </div>

        <form asp-action="ChangePassword" method="post" class="profile-form-card password-card">
            @if (ViewBag.Success != null) { <div class="alert alert-success">@ViewBag.Success</div> }
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="profile-form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Back</a>
                <button type="submit" class="btn btn-warning"><i class="bi bi-shield-check me-2"></i>Confirm Change</button>
            </div>
        </form>
    </div>
</div>

@section Scripts { @{await Html.RenderPartialAsync("_ValidationScriptsPartial");} }
